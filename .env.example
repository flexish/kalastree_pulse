# Copy this file to .env and adjust values for your environment.
# Every variable maps to a field in app/core/config.py::Settings.

ENVIRONMENT=development
DEBUG=True

HOST=0.0.0.0
PORT=8000

# Generate a real secret for anything beyond local development,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-me-in-production
SESSION_COOKIE_NAME=kalastree_session

# Shared admin password — change this. Anyone signed in who knows it can
# view the admin dashboard at /admin.
ADMIN_PASSWORD=change-me-admin

# Used to compute participation % even without a roster (see below).
TEAM_SIZE=10

# Off by default — any correctly-formatted name can sign in. Turn on once
# config/team_roster.json is filled in with your team's real names; see
# config/README.md for the full walkthrough.
TEAM_ROSTER_ENABLED=False

LOG_LEVEL=INFO

# --- Mission / company goals (targets only — see KPI_* below for current values) --
# Drives the mission-progress card on the home dashboard and the target
# side of the Business Growth page. Configurable rather than hardcoded —
# see app/services/mission.py.
# MISSION_NAME=Kalastree's First Crore
# MISSION_REVENUE_TARGET=10000000
# MISSION_DEADLINE=2026-11-30
# MISSION_ORDERS_TARGET=500
# MISSION_ARTISANS_TARGET=50
# MISSION_PRODUCTS_TARGET=200
# MISSION_PARTNERSHIPS_TARGET=10

# --- Business KPIs (Phase 8) ---------------------------------------------------
# Current values — what the mission-progress %, the Business Growth page,
# and the tree-growth rules (config/tree_rules.json) all measure against.
# See app/services/kpis.py and config/README.md.
# KPI_REVENUE=0
# KPI_ORDERS=0
# KPI_WOMEN_ARTISANS=0
# KPI_PRODUCTS_LISTED=0
# KPI_WEBSITE_VISITORS=0
# KPI_REPEAT_CUSTOMERS=0
# KPI_PARTNERSHIPS=0
# KPI_SOCIAL_FOLLOWERS=0

# --- Google Sheets ------------------------------------------------------------
# Off by default so the app runs fully (reflections still log) without any
# setup. See README "Setting up Google Sheets" for the full walkthrough.
GOOGLE_SHEETS_ENABLED=False
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials/service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=Reflections

# --- AI Insights (Phase 10) -----------------------------------------------------
# Placeholders only — no API key is required. AI_PROVIDER=none (the
# default) uses the built-in, data-driven insights engine. Setting this to
# openai/claude/gemini without also implementing the corresponding
# provider function in app/services/ai_insights.py falls back to the
# built-in summary automatically (logged, not an error).
AI_PROVIDER=none
# AI_OPENAI_API_KEY=
# AI_CLAUDE_API_KEY=
# AI_GEMINI_API_KEY=
